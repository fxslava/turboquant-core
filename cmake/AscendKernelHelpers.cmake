include_guard(GLOBAL)

# Use the SDK's ASC driver to split host/device compilation and select ISA.
function(tq_add_ascend_kernel)
  cmake_parse_arguments(K "" "TARGET;RUN_MODE" "SOURCES;DEFS;INCLUDES;DEVICE_OPTIONS;HOST_OPTIONS" ${ARGN})
  if(K_UNPARSED_ARGUMENTS OR NOT K_TARGET OR NOT K_SOURCES OR NOT K_RUN_MODE)
    message(FATAL_ERROR "tq_add_ascend_kernel requires TARGET, RUN_MODE and SOURCES")
  endif()
  if(NOT K_RUN_MODE STREQUAL CMAKE_ASC_RUN_MODE)
    message(FATAL_ERROR "Kernel ${K_TARGET} runtime differs from this build's ASC runtime")
  endif()
  set(sources)
  foreach(source IN LISTS K_SOURCES)
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    list(APPEND sources "${source}")
  endforeach()
  ascendc_library(${K_TARGET} SHARED ${sources})
  ascendc_compile_definitions(${K_TARGET} PRIVATE ASCEND_MICRO_CANN_LAUNCH ${K_DEFS})
  # Device SDK warnings stay warnings. Host-owned launch code keeps strict warnings.
  # Group host options so CMake cannot deduplicate them against device options.
  string(JOIN " " host_options -Wall -Wextra -Werror ${K_HOST_OPTIONS})
  ascendc_compile_options(${K_TARGET} PRIVATE
      -std=c++17 -Wall -Wextra ${K_DEVICE_OPTIONS}
      -forward-options-to-host-compiler "SHELL:${host_options}")
  target_include_directories(${K_TARGET} SYSTEM PRIVATE ${TQ_CANN_SYSTEM_DIRS})
  target_include_directories(${K_TARGET} PRIVATE ${K_INCLUDES})
  set_target_properties(${K_TARGET} PROPERTIES
      BUILD_RPATH "$ORIGIN;${ASCEND_HOME_PATH}/lib64;${TQ_SIM_LIB_DIR}")
endfunction()

function(tq_add_device_runner name source)
  get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
  add_executable(${name} EXCLUDE_FROM_ALL "${source}")
  target_include_directories(${name} PRIVATE "${PROJECT_SOURCE_DIR}")
  target_include_directories(${name} SYSTEM PRIVATE "${ASCEND_HOME_PATH}/include")
  target_compile_options(${name} PRIVATE -Wall -Wextra -Werror ${TQ_TELEMETRY_DEFINES})
  target_link_libraries(${name} PRIVATE ${ARGN} turboquant_host ascendcl)
  if(RUN_MODE STREQUAL "sim")
    target_link_directories(${name} BEFORE PRIVATE "${TQ_SIM_LIB_DIR}")
    target_link_libraries(${name} PRIVATE runtime_camodel npu_drv_camodel model_top)
    target_link_options(${name} PRIVATE "-Wl,-rpath-link,${TQ_SIM_LIB_DIR}" "-Wl,--disable-new-dtags")
  else()
    # Resolve indirect runtime dependencies on servers with a separate driver package.
    set(driver_home "/usr/local/Ascend/driver")
    if(EXISTS "/etc/ascend_install.info")
      file(STRINGS "/etc/ascend_install.info" driver_path REGEX "^[Dd]river_[Ii]nstall_[Pp]ath_[Pp]aram=")
      if(driver_path)
        string(REGEX REPLACE "^[^=]*=" "" driver_root "${driver_path}")
        if(EXISTS "${driver_root}/driver")
          set(driver_home "${driver_root}/driver")
        endif()
      endif()
    endif()
    foreach(path IN ITEMS "${driver_home}/lib64" "${driver_home}/lib64/driver")
      if(EXISTS "${path}")
        target_link_options(${name} PRIVATE "-Wl,-rpath-link,${path}")
      endif()
    endforeach()
  endif()
  set_target_properties(${name} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE
      INSTALL_RPATH "$ORIGIN/../lib;${ASCEND_HOME_PATH}/lib64;${TQ_SIM_LIB_DIR}")
endfunction()

function(tq_add_native_kernels mode)
  foreach(layout IN ITEMS strip nz)
    set(defs)
    set(suffix "_${mode}")
    if(layout STREQUAL "nz")
      set(defs TURBOQUANT_INGRESS_NZ=1)
      set(suffix "_nz_${mode}")
    endif()
    tq_add_ascend_kernel(TARGET tq_prefill${suffix} RUN_MODE ${mode}
        SOURCES src/turboquant/ingress/native/turboquant_reshape_batch.cpp
                src/turboquant/ingress/native/turboquant_reshape_batch_wide.cpp
        DEFS ${defs})
    tq_add_ascend_kernel(TARGET tq_scatter${suffix} RUN_MODE ${mode}
        SOURCES src/turboquant/ingress/native/turboquant_reshape_scatter.cpp DEFS ${defs})
  endforeach()
  tq_add_ascend_kernel(TARGET tq_decode_${mode} RUN_MODE ${mode}
      SOURCES src/turboquant/decode/native/turboquant_fused_decode.cpp
      DEFS ${TQ_KERNEL_REDUCE_DEFS} ${TQ_KERNEL_TELEMETRY_DEFS}
      INCLUDES "${PROJECT_SOURCE_DIR}/src/turboquant")
endfunction()

function(tq_add_production_runners mode)
  set(libraries tq_decode_${mode} tq_scatter_nz_${mode})
  if(TQ_BUILD_E8_KERNELS)
    list(APPEND libraries tq_e8_reader tq_e8_dequant)
  endif()
  foreach(prefix IN ITEMS test bench)
    set(runner ${prefix}_turboquant_production_${mode})
    tq_add_device_runner(${runner} "${PROJECT_SOURCE_DIR}/benchmarks/benchmark_turboquant_production.cpp" ${libraries})
    target_include_directories(${runner} SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/tests/cpu/e8/frozen")
    target_compile_options(${runner} PRIVATE -fno-fast-math -ffp-contract=off)
    if(mode STREQUAL "sim")
      target_compile_definitions(${runner} PRIVATE TQ_PRODUCTION_SIM=1)
    endif()
    if(TQ_BUILD_E8_KERNELS)
      target_compile_definitions(${runner} PRIVATE TQ_HAS_E8_KERNELS=1)
    endif()
  endforeach()
  target_compile_definitions(test_turboquant_production_${mode} PRIVATE TQ_PRODUCTION_ACCURACY=1)
endfunction()

function(tq_add_standard_runners mode)
  tq_add_device_runner(test_live_write_${mode} tests/npu/test_live_write.cpp tq_prefill_${mode} tq_scatter_${mode})
  tq_add_device_runner(test_live_write_nz_${mode} tests/npu/test_live_write.cpp tq_scatter_nz_${mode})
  target_compile_definitions(test_live_write_nz_${mode} PRIVATE TQ_SCATTER_NZ=1)
  tq_add_device_runner(test_nz_ingress_canary_${mode} tests/npu/test_nz_ingress_canary.cpp tq_prefill_nz_${mode})
  tq_add_device_runner(test_fused_decode_e2e_${mode} tests/npu/test_fused_decode_e2e.cpp tq_decode_${mode})
  tq_add_device_runner(test_dirty_data_canary_${mode} tests/npu/test_dirty_data_canary.cpp tq_decode_${mode})
  foreach(gate IN ITEMS prefill_strip prefill_nz scatter decode)
    if(gate STREQUAL "prefill_strip")
      set(lib tq_prefill_${mode})
      set(defs TQ_GOLDEN_KERNEL_PREFILL=1 TQ_GOLDEN_PREFILL_NZ=0)
    elseif(gate STREQUAL "prefill_nz")
      set(lib tq_prefill_nz_${mode})
      set(defs TQ_GOLDEN_KERNEL_PREFILL=1 TQ_GOLDEN_PREFILL_NZ=1)
    elseif(gate STREQUAL "scatter")
      set(lib tq_scatter_${mode})
      set(defs TQ_GOLDEN_KERNEL_SCATTER=1)
    else()
      set(lib tq_decode_${mode})
      set(defs TQ_GOLDEN_KERNEL_DECODE=1)
    endif()
    tq_add_device_runner(test_golden_${gate}_${mode} "${PROJECT_SOURCE_DIR}/tests/npu/test_golden_dump.cpp" ${lib})
    target_compile_definitions(test_golden_${gate}_${mode} PRIVATE ${defs})
  endforeach()
  tq_add_production_runners(${mode})
endfunction()
